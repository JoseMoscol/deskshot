<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NuGet solo se utiliza al compilar. El OCR publicado funciona sin red. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config><add key="globalPackagesFolder" value=".dotnet/packages" /></config>
</configuration>
