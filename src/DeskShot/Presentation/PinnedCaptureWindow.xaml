<Window x:Class="DeskShot.Presentation.PinnedCaptureWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="DeskShot · Captura anclada"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False"
 Width="660" Height="470" MinWidth="360" MinHeight="180" WindowStartupLocation="CenterScreen"
 PreviewKeyDown="Window_KeyDown">
 <Border BorderBrush="#78E7C3" BorderThickness="1" Background="#0E131B">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="#17212E" Padding="9" MouseLeftButtonDown="Header_MouseDown">
    <StackPanel>
     <DockPanel Margin="0,0,0,7">
      <Button DockPanel.Dock="Right" Content="×" Click="Close_Click" Padding="11,2" AutomationProperties.Name="Cerrar captura anclada" />
      <TextBlock Text="CAPTURA ANCLADA · arrastra esta barra" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0,10,0" />
     </DockPanel>
     <WrapPanel>
      <Button Content="Copiar" Click="Copy_Click" Padding="11,7" Margin="0,0,6,4" ToolTip="Copiar imagen completa, sin reducirla (Ctrl+C)" />
      <Button Content="Editor" Click="Editor_Click" Padding="11,7" Margin="0,0,9,4" ToolTip="Abrir esta imagen en el editor para guardarla o añadir anotaciones" />
      <ComboBox x:Name="ZoomBox" SelectedIndex="0" SelectionChanged="Zoom_Changed" Width="100" Margin="0,0,9,4" AutomationProperties.Name="Zoom de captura anclada">
       <ComboBoxItem Content="Ajustar" /><ComboBoxItem Content="50 %" /><ComboBoxItem Content="100 %" /><ComboBoxItem Content="150 %" /><ComboBoxItem Content="200 %" />
      </ComboBox>
      <TextBlock Text="Opacidad" VerticalAlignment="Center" FontSize="12" Margin="0,0,7,4" />
      <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="100" ValueChanged="Opacity_Changed" Width="90" VerticalAlignment="Center" Margin="0,0,8,4" AutomationProperties.Name="Opacidad de captura anclada" />
      <Button Content="Restablecer" Click="Reset_Click" Padding="10,7" Margin="0,0,0,4" ToolTip="Restablecer vista y opacidad (Ctrl+0)" />
     </WrapPanel>
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="ImageViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Viewer_SizeChanged" Background="#080C12">
    <Image x:Name="PinnedImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
   </ScrollViewer>
   <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </Grid>
 </Border>
</Window>
