<Window x:Class="DeskShot.Presentation.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:domain="clr-namespace:DeskShot.Domain"
 Style="{StaticResource {x:Type Window}}"
 Title="DeskShot" Width="1060" Height="700" MinWidth="850" MinHeight="580" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ButtonChrome}">
   <Setter Property="HorizontalContentAlignment" Value="Left" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderBrush" Value="Transparent" />
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
   <Setter Property="Padding" Value="12,10" />
   <Setter Property="Margin" Value="0,0,0,4" />
   <Style.Triggers>
    <Trigger Property="Tag" Value="Active">
     <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
     <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
     <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
     <Setter Property="FontWeight" Value="SemiBold" />
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CaptureTile" TargetType="Button" BasedOn="{StaticResource ButtonChrome}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="VerticalContentAlignment" Value="Top" />
   <Setter Property="Padding" Value="16" />
   <Setter Property="MinHeight" Value="132" />
  </Style>
  <Style x:Key="IconTile" TargetType="Border">
   <Setter Property="Width" Value="38" />
   <Setter Property="Height" Value="38" />
   <Setter Property="CornerRadius" Value="9" />
   <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
   <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style x:Key="SectionCard" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="12" />
   <Setter Property="Padding" Value="20,17" />
   <Setter Property="Margin" Value="0,0,0,14" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Margin" Value="0,0,0,7" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="202" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="14,23,14,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="6,0,0,27">
     <Border Background="{DynamicResource AccentFillBrush}" CornerRadius="9" Width="36" Height="36"
      TextElement.Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,10,0">
      <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconRegion}" Width="22" Height="22" />
     </Border>
     <TextBlock Text="DeskShot" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="Home_Click" AutomationProperties.Name="Inicio" Tag="Active">
      <StackPanel Orientation="Horizontal">
       <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconHome}" Margin="0,0,11,0" />
       <TextBlock Text="Inicio" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click" AutomationProperties.Name="Configuración">
      <StackPanel Orientation="Horizontal">
       <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconSettings}" Margin="0,0,11,0" />
       <TextBlock Text="Configuración" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="8,10,8,11" />
     <Button Style="{StaticResource NavButton}" Click="OpenFolder_Click" AutomationProperties.Name="Abrir carpeta">
      <StackPanel Orientation="Horizontal">
       <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconFolder}" Margin="0,0,11,0" />
       <TextBlock Text="Abrir carpeta" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <Button x:Name="PdfButton" Style="{StaticResource NavButton}" Click="Pdf_Click" AutomationProperties.Name="Crear PDF">
      <StackPanel Orientation="Horizontal">
       <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconPdf}" Margin="0,0,11,0" />
       <TextBlock Text="Crear PDF" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <Button x:Name="UpdatesButton" Style="{StaticResource NavButton}" Click="Updates_Click" AutomationProperties.Name="Actualizaciones">
      <StackPanel Orientation="Horizontal">
       <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconUpdate}" Margin="0,0,11,0" />
       <TextBlock Text="Actualizaciones" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button Style="{StaticResource NavButton}" Click="Exit_Click" AutomationProperties.Name="Salir de DeskShot">
      <StackPanel Orientation="Horizontal">
       <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconExit}" Margin="0,0,11,0" />
       <TextBlock Text="Salir de DeskShot" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11" Margin="12,5,0,0" />
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,18" MaxWidth="1060">
     <StackPanel x:Name="HomePanel">
      <TextBlock Text="Capturas" FontSize="34" FontWeight="SemiBold" />
      <Border Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource AccentBorderBrush}"
       BorderThickness="1" CornerRadius="16" Padding="24" MinHeight="216" Margin="0,19,0,0">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="Capturar región" FontSize="28" FontWeight="SemiBold" />
         <TextBlock Text="Selecciona un área de la pantalla para anotarla, copiarla o guardarla." Style="{StaticResource MutedText}" Margin="0,8,15,22" MaxWidth="340" HorizontalAlignment="Left" />
         <WrapPanel>
          <Button x:Name="RegionButton" Style="{StaticResource AccentButton}" Click="CaptureRegion_Click"
           AutomationProperties.Name="Capturar región" Padding="15,10" Margin="0,0,10,0">
           <StackPanel Orientation="Horizontal">
            <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconRegion}" Margin="0,0,8,0" />
            <TextBlock Text="Iniciar captura" VerticalAlignment="Center" />
           </StackPanel>
          </Button>
          <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
           CornerRadius="7" Padding="9,5" VerticalAlignment="Center" Margin="0,3">
           <TextBlock x:Name="ShortcutSummary" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
          </Border>
         </WrapPanel>
        </StackPanel>
        <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="282" MaxHeight="170" Margin="10,0,0,0" IsHitTestVisible="False">
         <Canvas Width="270" Height="164">
          <Border Canvas.Left="14" Canvas.Top="17" Width="228" Height="131" CornerRadius="12" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Opacity="0.64" />
          <Border Canvas.Left="29" Canvas.Top="28" Width="226" Height="125" CornerRadius="11" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
          <Path Data="M 29,52 H 255 M 103,52 V 152" Stroke="{DynamicResource BorderBrush}" />
          <StackPanel Orientation="Horizontal" Canvas.Left="41" Canvas.Top="38">
           <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
           <Ellipse Width="5" Height="5" Fill="{DynamicResource BorderBrush}" Margin="4,0" />
           <Ellipse Width="5" Height="5" Fill="{DynamicResource BorderBrush}" />
          </StackPanel>
          <Path Data="M 43,70 H 79 M 43,84 H 88 M 43,98 H 70 M 43,112 H 82" Stroke="{DynamicResource BorderBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Border Canvas.Left="118" Canvas.Top="63" Width="121" Height="70" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="5" />
          <Path Data="M 130,103 L 149,85 L 165,98 L 193,75 L 224,106 M 131,116 H 202" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.6" />
          <Path Data="M 118,78 V 63 H 133 M 224,63 H 239 V 78 M 239,118 V 133 H 224 M 133,133 H 118 V 118" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" />
          <Path Data="M 0,0 L 16,10 L 9,11 L 5,17 Z" Canvas.Left="218" Canvas.Top="119" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1.3" />
         </Canvas>
        </Viewbox>
       </Grid>
      </Border>

      <TextBlock Text="Otras herramientas" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,11" />
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
       <Button x:Name="DesktopButton" Grid.Column="0" Style="{StaticResource CaptureTile}" Click="CaptureDesktop_Click" AutomationProperties.Name="Escritorio completo">
        <StackPanel>
         <Grid>
          <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconDesktop}" /></Border>
          <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconForward}" Width="15" Height="15" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
         </Grid>
         <TextBlock Text="Escritorio completo" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,5" />
         <TextBlock Text="Captura todas las pantallas." Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
       </Button>
       <Button x:Name="ScrollButton" Grid.Column="2" Style="{StaticResource CaptureTile}" Click="CaptureScroll_Click" AutomationProperties.Name="Desplazamiento">
        <StackPanel>
         <Grid>
          <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconScroll}" /></Border>
          <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconForward}" Width="15" Height="15" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
         </Grid>
         <TextBlock Text="Desplazamiento" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,5" />
         <TextBlock Text="Une páginas y documentos largos." Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
       </Button>
       <Button x:Name="QuickOcrButton" Grid.Column="4" Style="{StaticResource CaptureTile}" Click="QuickOcr_Click" AutomationProperties.Name="OCR rápido">
        <StackPanel>
         <Grid>
          <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left"><ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconOcr}" /></Border>
          <ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconForward}" Width="15" Height="15" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
         </Grid>
         <TextBlock Text="OCR rápido" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,5" />
         <TextBlock x:Name="OcrShortcutSummary" Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
       </Button>
      </Grid>
      <TextBlock x:Name="FormatSummary" Style="{StaticResource MutedText}" FontSize="12" Margin="0,19,0,0" />
     </StackPanel>

     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
      <TextBlock Text="Configuración" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,19" />

      <Border Style="{StaticResource SectionCard}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource IconTile}" Margin="0,0,13,0"><ContentControl Style="{StaticResource Icon}" Content="{StaticResource IconTheme}" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
         <TextBlock Text="Apariencia" FontSize="16" FontWeight="SemiBold" />
         <TextBlock Text="El cambio se aplica al instante." Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <ComboBox x:Name="AppearanceBox" Grid.Column="2" Width="150" MinHeight="36" VerticalAlignment="Center"
         SelectedValuePath="Tag" SelectionChanged="AppearanceBox_SelectionChanged" AutomationProperties.Name="Apariencia">
         <ComboBoxItem Content="Sistema" Tag="{x:Static domain:AppAppearance.System}" />
         <ComboBoxItem Content="Claro" Tag="{x:Static domain:AppAppearance.Light}" />
         <ComboBoxItem Content="Oscuro" Tag="{x:Static domain:AppAppearance.Dark}" />
        </ComboBox>
       </Grid>
      </Border>

      <Border Style="{StaticResource SectionCard}">
       <StackPanel>
        <TextBlock Text="Atajos globales" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,13" />
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Capturar región" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="ShortcutBox" IsReadOnly="True" PreviewKeyDown="ShortcutBox_PreviewKeyDown" AutomationProperties.Name="Atajo global de captura" />
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="OCR rápido" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="OcrShortcutBox" IsReadOnly="True" PreviewKeyDown="ShortcutBox_PreviewKeyDown" AutomationProperties.Name="Atajo global de OCR rápido" />
         </StackPanel>
        </Grid>
        <TextBlock Text="Haz clic en un campo y pulsa tu combinación de teclas." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
       </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}">
       <StackPanel>
        <TextBlock Text="Captura y guardado" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,13" />
        <TextBlock Text="Carpeta de destino" Style="{StaticResource FieldLabel}" />
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="Elegir…" Click="BrowseFolder_Click" Margin="8,0,0,0" />
         <TextBox x:Name="FolderBox" AutomationProperties.Name="Carpeta de destino" />
        </DockPanel>
        <Grid Margin="0,14,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,14,0">
          <TextBlock Text="Formato" Style="{StaticResource FieldLabel}" />
          <ComboBox x:Name="FormatBox" MinHeight="36" SelectedIndex="0" SelectionChanged="FormatBox_SelectionChanged" AutomationProperties.Name="Formato de imagen">
           <ComboBoxItem Content="PNG · sin pérdida" /><ComboBoxItem Content="JPG · comprimido" />
          </ComboBox>
         </StackPanel>
         <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="Calidad JPG (1–100)" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="QualityBox" AutomationProperties.Name="Calidad JPG" />
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="Espera (segundos)" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="DelayBox" AutomationProperties.Name="Espera antes de capturar" />
         </StackPanel>
        </Grid>
        <StackPanel Margin="0,12,0,0">
         <CheckBox x:Name="CopyBox" Content="Copiar al portapapeles después de capturar" />
         <CheckBox x:Name="AutoSaveBox" Content="Guardar automáticamente una copia al capturar" />
        </StackPanel>
        <TextBlock Text="En el selector flotante, Copiar puede guardar una copia automática y Guardar puede copiar la imagen. Al abrir el editor se aplican ambas preferencias."
         Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
       </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}" Margin="0">
       <StackPanel>
        <TextBlock Text="Aplicación" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox x:Name="TrayBox" Content="Al cerrar, mantener DeskShot en la bandeja del sistema" />
        <CheckBox x:Name="UpdateCheckBox" Content="Buscar actualizaciones al iniciar" />
        <TextBlock Text="Solo la búsqueda de actualizaciones consulta GitHub. Las capturas y el OCR funcionan sin conexión."
         Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>

   <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="0,1,0,0" Padding="32,12">
    <DockPanel MaxWidth="1060">
     <Button x:Name="SavePreferencesButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="SaveSettings_Click"
      Content="Guardar configuración" Visibility="Collapsed" Margin="16,0,0,0" />
     <TextBlock x:Name="StatusText" Text="Listo" Style="{StaticResource MutedText}" FontSize="12"
      VerticalAlignment="Center" MinHeight="19" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
